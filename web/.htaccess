Options -Indexes
DirectoryIndex index.html

# Always use HTTPS (the login cookie and the installable app both need it).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Hide dotfiles (except .well-known, which certificate renewal uses).
<IfModule mod_rewrite.c>
    RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always set Strict-Transport-Security "max-age=15552000"

    # The service worker and the page shell must be re-checked on every load
    # so a deploy reaches the phone straight away.
    <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
